# API
DATABASE_URL=postgresql://vianomics:vianomics@localhost:5432/vianomics
REDIS_URL=redis://localhost:6379/0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# When true, backend serves explicitly-labeled demo fixtures for unpopulated sections.
# Production must run with this false.
DEMO_FIXTURES=true
EXECUTION_ENABLED=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# Market data providers (see /settings for per-key status)
# TIINGO_API_KEY=           # daily bars, IEX intraday
# FRED_API_KEY=             # macro series
# ALPACA_API_KEY=PKxxxx     # Alpaca data (quotes/bars/news) + trading
# ALPACA_SECRET_KEY=SKxxxx  # required pair with the key id
# ALPACA_BASE_URL=https://paper-api.alpaca.markets  # or api.alpaca.markets

# Brokers / external accounts
# MT4_PUSH_SECRET=          # VAIIP_Push.mq4 EA input
# IBKR_FLEX_TOKEN=          # read-only portfolio sync, no gateway
# IBKR_FLEX_QUERY_ID=       # Activity Flex Query (positions + cash)
# IBKR_HOST/IBKR_PORT/IBKR_CLIENT_ID=  # live trading via TWS/Gateway
