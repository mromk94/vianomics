[Unit]
Description=IB Gateway via IBC (auto-relogin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vaiip
# gatewaystart.sh does NOT handle the display — without an X server
# the Swing login dialog never renders and IBC times out in a 60s
# restart loop. xvfb-run provides the virtual framebuffer.
ExecStart=/usr/bin/xvfb-run -a /opt/ibc/gatewaystart.sh -inline
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
