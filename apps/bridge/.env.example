# VAIIP IBKR bridge — copy to .env (systemd EnvironmentFile)
IBKR_HOST=127.0.0.1
# IB Gateway: 4002 paper / 4001 live · TWS: 7497 paper / 7496 live
IBKR_PORT=4002
IBKR_CLIENT_ID=7
# pin to one account id (e.g. DU1234567) or leave blank for default
IBKR_ACCOUNT=
# 'false' only when ready to place orders — order routes 403 while true
IBKR_READONLY=true
# openssl rand -hex 32 — must match IBKR_BRIDGE_SECRET on the API
IBKR_BRIDGE_SECRET=
